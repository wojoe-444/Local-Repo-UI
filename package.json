{
  "name": "local-repo-ui",
  "version": "0.1.0",
  "description": "GitHub-style browsing UI for local git repositories. Everything stays on your machine.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wojoe-444/local-repo-ui.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wojoe-444/local-repo-ui/issues"
  },
  "homepage": "https://github.com/wojoe-444/local-repo-ui#readme",
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.5",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "private": true,
  "build": {
    "appId": "dev.localrepoui.app",
    "productName": "Local Repo UI",
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
